# =========================================================================
# ACE GLOBAL LOGISTICS - ENVIRONMENT VARIABLES
# =========================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Supabase Service Role Key (server-side only, bypasses RLS for admin scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
